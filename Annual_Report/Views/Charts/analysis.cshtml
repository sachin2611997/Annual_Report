/*start Female modality*/
.tmfchart-page-title {
      text-align: center;
      font-size: 17px;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 4px;
    }
    .tmfchart-page-sub {
      text-align: center;
      font-size: 11px;
      color: #999;
      margin-bottom: 20px;
    }

    /* Shared legend at top */
    .tmfchart-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
      justify-content: center;
    }
    .tmfchart-legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      user-select: none;
      font-size: 18px;
      font-weight: 500;
      color: #444;
      padding: 5px 14px;
      border-radius: 4px;
      border: 2px solid transparent;
      transition: all 0.2s ease;
    }
    .tmfchart-legend-item.tmfchart-active   { border-color: inherit; background: #f7f8ff; }
    .tmfchart-legend-item.tmfchart-inactive { opacity: 0.35; background: #eee; }
    .tmfchart-legend-dot { width: 13px; height: 13px; border-radius: 3px; flex-shrink: 0; }

    /* Two panel layout */
    .tmfchart-panels {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      width: 100%;
      /*max-width: 1300px;*/
      margin: 0 auto;
    }

    /* Each panel card */
    .tmfchart-panel {
      flex: 1;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 2px 14px rgba(0,0,0,0.07);
      padding: 20px 18px 14px;
      min-width: 0;
    }

    .tmfchart-panel-title {
      text-align: center;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 18px;
      display: inline-block;
      width: 100%;
    }
    .tmfchart-panel-title.loco  { background: linear-gradient(90deg, #1b2fad, #4a5fd4); }
    .tmfchart-panel-title.dmets { background: linear-gradient(90deg, #c0392b, #e74c3c); }

    /* Cancer group */
    .tmfchart-group { margin-bottom: 12px; }

    /* Row */
    .tmfchart-row { display: flex; align-items: center; margin-bottom: 1px; }

    /* Label col */
    .tmfchart-label-col {
      width: 110px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: 8px;
      gap: 5px;
    }
    .tmfchart-cancer-name {
      font-size: 14px;
      font-weight: 700;
      color: #333;
      text-align: right;
      line-height: 1.2;
    }
    .tmfchart-age-badge {
      font-size: 14px;
      color: #000;
      white-space: nowrap;
    }

    /* Bar */
    .tmfchart-bar {
      flex: 1;
      display: flex;
      height: 32px;
      border-radius: 4px;
      overflow: hidden;
      background: #f0f1f5;
    }

    /* Segment */
    .tmfchart-seg {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      overflow: hidden;
      white-space: nowrap;
      transition:
        max-width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
        width     0.45s cubic-bezier(0.4, 0, 0.2, 1),
        opacity   0.35s ease;
    }
     /* X Axis */
    .tmfchart-axis-row    { display: flex; align-items: flex-start; margin-top: 8px; }
    .tmfchart-axis-spacer { width: 110px; flex-shrink: 0; }
    .tmfchart-axis-ticks  { flex: 1; display: flex; border-top: 1px solid #e0e0e0; padding-top: 4px; }
    .tmfchart-axis-tick   { font-size: 9px; color: #bbb; flex: 1; text-align: center; }
    .tmfchart-axis-tick:first-child { text-align: left; flex: 0; }
 @@media (max-width: 700px) {
      .tmfchart-panels { flex-direction: column; }
    }

/*end Female modality*/

