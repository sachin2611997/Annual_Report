const ages = ["20-59","60+"];
const rowsPerGroup = 3;

const valueLabelPlugin = {
  id:'vlp',
  afterDatasetsDraw(chart){
    const ctx=chart.ctx; ctx.save();
    ctx.font='bold 14px Arial'; ctx.textAlign='center'; ctx.textBaseline='middle';
    chart.data.datasets.forEach((ds,i)=>{
      if(ds.hidden) return;
      const meta=chart.getDatasetMeta(i);
      meta.data.forEach((bar,idx)=>{
        const v=ds.data[idx];
        if(v===null||v===undefined||v<3) return;
        const bw=Math.abs(bar.base-bar.x);
        const x=Math.min(bar.base,bar.x)+(bw/2);
        const y=bar.y;
        ctx.fillStyle=bw>22?'white':'black';
        ctx.fillText(v.toFixed(1),x,y);
      });
    });
    ctx.restore();
  }
};

function makeLabelsPlugin(cancers) {
  return {
    id:'customLabels',
    afterDraw(chart){
      const ctx=chart.ctx;
      const yAxis=chart.scales.y;
      const xRight=chart.chartArea.right;
      const xLeft=chart.chartArea.left;
      ctx.save();

      // Cancer names on LEFT
      ctx.font='bold 14px Arial';
      ctx.fillStyle='#333';
      ctx.textAlign='right';
      ctx.textBaseline='middle';
      cancers.forEach((c,i)=>{
        const base=i*rowsPerGroup;
        const y0=yAxis.getPixelForValue(base);
        const y1=yAxis.getPixelForValue(base+1);
        const y=(y0+y1)/2;
        ctx.fillText(c, xLeft-6, y);
      });

      // Age labels on RIGHT
      ctx.font='bold 14px Arial';
      ctx.fillStyle='#555';
      ctx.textAlign='left';
      cancers.forEach((c,i)=>{
        ages.forEach((age,ai)=>{
          const rowIdx=i*rowsPerGroup+ai;
          const y=yAxis.getPixelForValue(rowIdx);
          ctx.fillText(age, xRight+6, y);
        });
      });

      ctx.restore();
    }
  };
}

const allCharts = {male:[], female:[]};

function buildChart(canvasId, dataByAge, group) {
  const cancers = dataByAge[ages[0]].map(d=>d.c);

  const labels = [];
  cancers.forEach(() => {
    labels.push(''); labels.push(''); labels.push('');
  });

  const datasets = treatments.map(t => {
    const data = labels.map((lbl,i) => {
      const cIdx=Math.floor(i/rowsPerGroup);
      const slot=i%rowsPerGroup;
      if(slot===2) return null;
      const age=ages[slot];
      const cancer=cancers[cIdx];
      const row=dataByAge[age].find(d=>d.c===cancer);
      return row ? (row[keyMap[t]]||0) : 0;
    });
    return {
      label:t, data,
          backgroundColor: colors[t],
          borderColor: '#ffffff',   // ✅ black border
          borderWidth: 1,
      stack:'stack', hidden:false,
      categoryPercentage:1.0, barPercentage:1.0
    };
  });

  const labelsPlugin = makeLabelsPlugin(cancers);

  const chart = new Chart(document.getElementById(canvasId), {
    type:'bar',
    data: { labels, datasets },
   
    options:{
      indexAxis:'y',
      responsive:true,
      maintainAspectRatio:false,
      plugins: {
          datalabels: {
              display: false   // ❌ disables duplicate labels
          },
        legend:{display:false},
        tooltip:{
          filter: item => item.parsed.x !== null && item.parsed.x > 0,
          callbacks:{
            title: items => {
              const i=items[0].dataIndex;
              const cIdx=Math.floor(i/rowsPerGroup);
              const slot=i%rowsPerGroup;
              return cancers[cIdx]+' — '+ages[slot];
            },
            label: c => c.dataset.label+': '+(c.parsed.x||0).toFixed(2)+'%'
          }
        }
      },
      scales:{
          x: {
              stacked: true, min: 0, max: 100,
              display: false,
              grid: { display: false }
             
          },
        y:{
          stacked:true,
          grid:{display:false},
          border:{display:false},
          ticks:{display:false}
        }
      },
      layout:{padding:{left:90, right:60, top:4, bottom:4}}
    },
    plugins:[valueLabelPlugin, labelsPlugin]
  });

  allCharts[group].push(chart);
}

buildChart('c1', maleData, 'male');
buildChart('c2', femaleData, 'female');

function makeLegend(id, group) {
  const el=document.getElementById(id);
  const vis={};
  treatments.forEach(t=>{vis[t]=true;});
  treatments.forEach(t=>{
    const s=document.createElement('span');
    s.className = 'legend-itemt';
    s.textContent = t;
    //s.style.backgroundColor = colors[t];
      // small box color
  
    s.style.setProperty('--legend-color', colors[t]);
    s.dataset.t = t;
    el.appendChild(s);
  });
  el.addEventListener('click',e=>{
    if(!e.target.classList.contains('legend-itemt')) return;
    const t = e.target.dataset.t;
    vis[t] = !vis[t];
    e.target.classList.toggle('hidden',!vis[t]);
    allCharts[group].forEach(ch=>{
      ch.data.datasets.forEach(ds=>{if(ds.label===t) ds.hidden=!vis[t];});
      ch.update();
    });
  });
}

makeLegend('legend1','male');
makeLegend('legend2','female');
</script>

<!--End Treatment-->



