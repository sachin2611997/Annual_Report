<h2></h2>

<!-- Shared Legend -->
<div id="shared-legend" style="margin-bottom: 20px;">
    <span class="legend-item" data-index="0" style="cursor:pointer;font-size:18px; padding:5px 10px; background-color:#0000c0;color:#ffffff; margin-right:10px; border-radius:4px;">20-39</span>
    <span class="legend-item" data-index="1" style="cursor:pointer; padding:5px 10px; background-color:#008000;color:#ffffff; margin-right:10px; border-radius:4px;">40-59</span>
    <span class="legend-item" data-index="2" style="cursor:pointer; padding:5px 10px; background-color:#ff0000;color:#ffffff; border-radius:4px;">60+</span>
</div>
<div style="text-align:center;background:#1769aa; margin-bottom: 20px;">
    <h1 style="color:white">Male</h1>
</div>
<!--male -->
<div style="display: flex; gap: 20px;">
    
    <div style="width: 600px;">
        <h3 style="text-align:center">Lung</h3>
        <canvas id="LungchartCE1" width="600" height="400"></canvas>
    </div>

    <div style="width: 600px;">
        <h3 style="text-align:center">Prostate</h3>
        <canvas id="ProstatechartCE2" width="600" height="400"></canvas>
    </div>

    <div style="width: 600px;">
        <h3 style="text-align:center">Buccal Mucosa</h3>
        <canvas id="bmchartCE3" width="600" height="400"></canvas>
    </div>
   
</div>
