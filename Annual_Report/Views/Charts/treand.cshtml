
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Female Cancer Trends – Total 1984–2018</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f5f5f3;
            color: #1a1a1a;
            padding: 32px 20px;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: #fff;
            border-radius: 12px;
            padding: 28px 32px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }

        h1 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 4px;
            color: #111;
        }

        .subtitle {
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        .section-label {
            font-size: 12px;
            color: #888;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        #cancer-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            padding: 5px 12px;
            border-radius: 6px;
            border: 1px solid #e0e0dd;
            font-size: 13px;
            background: #fff;
            transition: all 0.15s;
            user-select: none;
        }

            .legend-item:hover {
                background: #f0f0ee;
            }

            .legend-item.active {
                background: #f0f0ee;
                border-color: #bbb;
                font-weight: 500;
            }

        .legend-dot {
            width: 22px;
            height: 3px;
            border-radius: 2px;
        }

        .chart-wrapper {
            position: relative;
            width: 100%;
            height: 660px;
            margin-bottom: 28px;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
            margin-top: 8px;
        }

        .summary-card {
            background: #f5f5f3;
            border-radius: 8px;
            padding: 14px 16px;
        }

            .summary-card .s-label {
                font-size: 11px;
                color: #888;
                margin-bottom: 6px;
            }

            .summary-card .s-value {
                font-size: 22px;
                font-weight: 700;
            }

            .summary-card .s-change {
                font-size: 11px;
                margin-top: 4px;
            }

        .up {
            color: #2e9e74;
        }

        .down {
            color: #c25a2e;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Female Cancer  – Total Cases</h1>
       

        <p class="section-label">Cancer type</p>
        <div id="cancer-legend"></div>

        <div class="chart-wrapper">
            <canvas id="trendChart"></canvas>
        </div>

       
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
    <script>
  Chart.register(ChartDataLabels);

  const years = ['1984','1989','1990–96','1997–98','1999–00','2001–03','2004–05','2006–08','2011','2012','2015–17','2018'];

  const raw = {
    Breast:      [317.8, 422.6, 449,   515.6, 517.9, 399.6, 449.5, 481.1, 621.3, 591.1, 605.2, 707.7],
    Cervix:      [239.6, 247.4, 223.7, 294.2, 269.7, 181.1, 192.5, 184.8, 155.3, 153.8, 125.6, 112.8],
    Lung:        [97.4,  101.7, 85,    107.7, 95.3,  76.1,  86.6,  91.3,  110.6, 170.3, 145.2, 123.3],
    GallBladder: [40.9,  46.4,  54.2,  56.1,  83.9,  42.5,  54,    57,    58.7,  79.9,  72.6,  59.5],
    Ovary:       [80.8,  103,   105.8, 141.8, 133.3, 116.8, 107.3, 117.1, 147.8, 149.3, 135.1, 140]
  };

  const cancers = Object.keys(raw);
  const palette = ['#3266ad','#c25a2e','#2e9e74','#9c4eb8','#b89a17'];

  // Fixed label direction per cancer — guaranteed no two share same direction
  // Breast=top, Cervix=right, Lung=left, GallBladder=bottom, Ovary=top-right via angle
  // We use 8 compass positions mapped per cancer so they never collide
  const LABEL_CONFIG = {
    Breast:      { align: 'top',    anchor: 'end',   offset: 8 },
    Cervix:      { align: 'right',  anchor: 'end',   offset: 8 },
    Lung:        { align: 'left',   anchor: 'end',   offset: 8 },
    GallBladder: { align: 'bottom', anchor: 'start', offset: 8 },
    Ovary:       { align: -60,      anchor: 'end',   offset: 10 }, // angle in degrees, shoots up-right
  };

  let highlighted = null;

  function buildDatasets() {
    return cancers.map((cancer, ci) => {
      const isVisible = highlighted === null || highlighted === cancer;
      const lc = LABEL_CONFIG[cancer];
      return {
        label: cancer,
        data: isVisible ? raw[cancer] : [],
        borderColor: palette[ci],
        backgroundColor: palette[ci] + '15',
        borderWidth: highlighted === cancer ? 3.5 : 2.5,
        pointRadius: 5,
        pointHoverRadius: 8,
        tension: 0.35,
        datalabels: {
          display: isVisible,
          align: lc.align,
          anchor: lc.anchor,
          offset: lc.offset,
          clamp: true,
          font: { size: 13, weight: '700' },
          color: '#000000',
          //  color:'#fff',
          //backgroundColor: palette[ci],
          borderRadius: 4,
          padding: { top: 3, bottom: 3, left: 5, right: 5 },
          formatter: v => v
        }
      };
    });
  }

  const ctx = document.getElementById('trendChart').getContext('2d');
  const chart = new Chart(ctx, {
    type: 'line',
    data: { labels: years, datasets: buildDatasets() },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      clip: false,
      interaction: { mode: 'index', intersect: false },
      layout: { padding: { top: 60, bottom: 30, left: 30, right: 60 } },
      plugins: {
        legend: { display: false },
        datalabels: { display: true },
        tooltip: {
          callbacks: {
            label: c => '  ' + c.dataset.label + ': ' + c.parsed.y
          }
        }
      },
      scales: {
        x: {
          grid: { color: 'rgba(0,0,0,0.07)' },
          ticks: { font: { size: 11 }, maxRotation: 40 }
        },
        y: {
          beginAtZero: false,
          grace: '25%',
          title: { display: true, text: 'Total Cases', font: { size: 12 } },
          grid: { color: 'rgba(0,0,0,0.07)' },
          ticks: { font: { size: 12 } }
        }
      }
    }
  });

  function refresh() {
    chart.data.datasets = buildDatasets();
    chart.update();
    updateSummary();
  }

  const legendEl = document.getElementById('cancer-legend');
  cancers.forEach((cancer, i) => {
    const item = document.createElement('div');
    item.className = 'legend-item active';
    item.innerHTML = '<span class="legend-dot" style="background:' + palette[i] + '"></span>' + cancer;
    item.addEventListener('click', () => {
      highlighted = (highlighted === cancer) ? null : cancer;
      legendEl.querySelectorAll('.legend-item').forEach((el, idx) => {
        el.classList.toggle('active', highlighted === null || highlighted === cancers[idx]);
      });
      refresh();
    });
    legendEl.appendChild(item);
  });

  function updateSummary() {
    const el = document.getElementById('summary-cards');
    el.innerHTML = '';
    cancers.forEach((cancer, ci) => {
      const first  = raw[cancer][0];
      const latest = raw[cancer][raw[cancer].length - 1];
      const change = ((latest - first) / first * 100).toFixed(1);
      const up = parseFloat(change) > 0;
      const card = document.createElement('div');
      card.className = 'summary-card';
      card.innerHTML =
        '<p class="s-label">' + cancer + '</p>' +
        '<p class="s-value" style="color:' + palette[ci] + '">' + latest + '</p>' +
        '<p class="s-change ' + (up?'up':'down') + '">' + (up?'▲':'▼') + ' ' + Math.abs(change) + '% vs 1984</p>';
      el.appendChild(card);
    });
  }
  updateSummary();
    </script>
</body>
</html>