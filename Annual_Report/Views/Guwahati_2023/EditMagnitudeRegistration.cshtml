@model List<Annual_Report.Models.MagnitudeRegistration>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Edit Magnitude Registration</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>

    <style>
        body {
            padding: 25px;
        }

        table input {
            width: 100%;
        }

        td {
            vertical-align: middle !important;
        }

        .action {
            width: 90px;
        }
    </style>

</head>

<body>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-success">
            @TempData["msg"]
        </div>
    }

    @using (Html.BeginForm("EditMagnitudeRegistration",
                               "TMH2022",
                               FormMethod.Post))
    {

        @Html.AntiForgeryToken()

        <table class="table table-bordered table-striped" id="tblData">

            <thead>

                <tr>

                    <th>Year</th>

                    <th>Total New Patients</th>

                    <th>Cancer Cases</th>

                    <th>Male</th>

                    <th>Female</th>

                    <th class="action">
                        Action
                    </th>

                </tr>

            </thead>

            <tbody>

                @for (int i = 0; i < Model.Count; i++)
                {

                    <tr>

                        @Html.HiddenFor(x => x[i].Id)

                        <td>

                            @Html.TextBoxFor(x => x[i].Year,
new { @class = "form-control year" })

                        </td>

                        <td>

                            @Html.TextBoxFor(x => x[i].TotalNewPatientsRegistered,
new { @class = "form-control" })

                        </td>

                        <td>

                            @Html.TextBoxFor(x => x[i].CancerCases,
new { @class = "form-control" })

                        </td>

                        <td>

                            @Html.TextBoxFor(x => x[i].MaleCases,
new { @class = "form-control" })

                        </td>

                        <td>

                            @Html.TextBoxFor(x => x[i].FemaleCases,
new { @class = "form-control" })

                        </td>

                        <td>

                            <button type="button"
                                    class="btn btn-danger btnDelete">

                                Delete

                            </button>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

        <button type="button"
                id="btnAdd"
                class="btn btn-primary">

            Add New Row

        </button>

        <input type="submit"
               value="Save"
               class="btn btn-success" />
            <a href="@Url.Action("Magnitude_Registration_Cancer_Cases","TMH2022")"
               class="btn btn-secondary">

                Cancel

            </a>
            <a href="@Url.Action("Magnitude_Registration_Cancer_Cases","TMH2022")"
               target="_blank"
               class="btn btn-info">

                View Report

            </a>
    }
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script>
         
$(function () {

    $("#btnAdd").click(function () {

        var index=$("#tblData tbody tr").length;

        var lastYear=0;

        $(".year").each(function(){

            lastYear=parseInt($(this).val());

        });

        if(isNaN(lastYear))
            lastYear=new Date().getFullYear();

        lastYear++;

        var html="";

        html+="<tr>";

        html+="<input type='hidden' name='["+index+"].Id' value='0'/>";

        html+="<td><input class='form-control year' name='["+index+"].Year' value='"+lastYear+"'/></td>";

        html+="<td><input class='form-control' name='["+index+"].TotalNewPatientsRegistered'/></td>";

        html+="<td><input class='form-control' name='["+index+"].CancerCases'/></td>";

        html+="<td><input class='form-control' name='["+index+"].MaleCases'/></td>";

        html+="<td><input class='form-control' name='["+index+"].FemaleCases'/></td>";

        html+="<td><button type='button' class='btn btn-danger btnDelete'>Delete</button></td>";

        html+="</tr>";

        $("#tblData tbody").append(html);

    });

    $(document).on("click",".btnDelete",function(){

        if(confirm("Delete this row ?"))
        {

            $(this).closest("tr").remove();

            ReIndex();

        }

    });

    $("form").submit(function(){

        ReIndex();

    });

    function ReIndex(){

        $("#tblData tbody tr").each(function(i){

            $(this).find("input").each(function(){

                var n=$(this).attr("name");

                if(n)
                {
                    n=n.replace(/\[\d+\]/,"["+i+"]");

                    $(this).attr("name",n);
                }

            });

        });

    }

});
$("form").submit(function (e) {

    ReIndex();

    var years = [];
    var duplicate = false;

    $(".year").each(function () {

        var year = $.trim($(this).val());

        if (years.indexOf(year) >= 0) {
            duplicate = true;
            $(this).focus();
            return false;
        }

        years.push(year);
    });

    if (duplicate) {
        alert("Duplicate Year is not allowed.");
        e.preventDefault();
        return false;
    }

});
$(document).on("keypress",
".number",
function (e) {

    if (e.which != 8 &&
        e.which != 0 &&
        (e.which < 48 || e.which > 57)) {
        return false;
    }

});
$(document).on("blur", ".number", function () {

    var value = $(this).val();

    if (value != "") {
        value = parseInt(value);

        $(this).val(value.toLocaleString('en-IN'));
    }

});
$("form").submit(function () {

    $(".number").each(function () {

        $(this).val($(this).val().replace(/,/g, ''));

    });

});

    </script>

</body>

</html>