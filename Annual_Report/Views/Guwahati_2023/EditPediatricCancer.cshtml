@model List<Annual_Report.Models.PediatricCancer>
@{
    Layout = null;
}



@{
    ViewBag.Title = "Pediatric Cancer";
}

<style>
    body {
        font-family: Calibri;
        font-size: 14px;
    }

    .chapter {
        text-align: center;
        font-size: 28px;
        font-weight: bold;
        font-style: italic;
        text-decoration: underline;
        margin-bottom: 20px;
    }

    .description {
        text-align: justify;
        font-size: 16px;
        line-height: 26px;
        margin-bottom: 20px;
    }

    .title {
        width: 350px;
        margin: auto;
        background: #777;
        color: white;
        text-align: center;
        padding: 6px;
        font-weight: bold;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    th, td {
        border: 1px solid #9cb96d;
        padding: 5px;
    }

    thead th {
        background: #dce6c1;
        text-align: center;
    }

    tbody tr:nth-child(even) {
        background: #f6f8ef;
    }

    tfoot {
        background: #dce6c1;
        font-weight: bold;
    }

    .left {
        text-align: left;
    }

    .center {
        text-align: center;
    }

    .tmc-title {
        text-decoration: underline;
        font-weight: 700;
        text-align: center;
    }

    .report-page {
        /*border: 1px solid #000;*/
        padding: 20px;
        margin: 20px auto;
        background: #fff;
        width: 95%;
        box-sizing: border-box;
    }

    @@page {
        margin-top: 5mm !important;
        margin-right: 4mm !important;
        margin-bottom: 5mm !important;
        margin-left: 8mm !important;
    }

    @@media print {


        .num,
        .per {
            white-space: nowrap;
            text-align: center;
            vertical-align: middle;
        }

        .per {
            min-width: 48px;
        }

        .num {
            min-width: 40px;
        }

        .totalRow td {
            white-space: nowrap !important;
            overflow: hidden;
        }

        table {
            width: 104%;
            margin-left: -2%;
            height: 70%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th, td {
            padding: 2px;
            font-size: 15px;
            /*line-height: 1.15;*/
            word-wrap: break-word;
        }

        .table-title {
            font-size: 16px;
        }

        tr {
            page-break-inside: avoid;
        }

        .page-break {
            page-break-before: always;
        }

        .report-page {
            width: 100%;
            /*padding: 12mm;*/
            border: 1px solid #000;
            /*box-sizing: border-box;*/
        }

        .number {
            white-space: nowrap;
            text-align: center;
        }

        .tw {
        }
    }
</style>

<div class="report-page">

    <div class="chapter">
        Chapter 6. Pediatric Cancer
    </div>
   
      
    
   
    @*<div class="description">

        <div style="font-size:18px; line-height:1.8; text-align:justify;">
            <textarea name="key" class="form-control"
                      rows="8"
                      style="font-size:18px; width:100%;">
                @ViewBag.key
            </textarea>
        </div>

    </div>*@

    <h3 class="tmc-title mb-6">
        Table 6: Pediatric Cancers-@ViewBag.year
    </h3>
@using (Html.BeginForm("EditPediatricCancer", "TMH2022", FormMethod.Post))
{
    <div style="font-size:18px; line-height:1.8; text-align:justify;">
        <textarea name="key" class="form-control"
                  rows="4"
                  style="font-size:18px; width:100%;">
            @ViewBag.key
        </textarea>
    </div>

    @Html.AntiForgeryToken()
  
      <table>

        <thead>

            <tr>

                <th rowspan="3" width="200;">
                    International Classification of Childhood Cancers
                </th>

                <th colspan="6">00-14</th>

                <th colspan="6">15-19</th>

                <th colspan="2">Total</th>

            </tr>

            <tr>

                <th colspan="2">Male</th>
                <th colspan="2">Female</th>
                <th colspan="2">Total</th>

                <th colspan="2">Male</th>
                <th colspan="2">Female</th>
                <th colspan="2">Total</th>

                <th rowspan="2">Nos</th>
                <th rowspan="2">%</th>

            </tr>

            <tr>

                <th>Nos</th>
                <th>%</th>

                <th>Nos</th>
                <th>%</th>

                <th>Nos</th>
                <th>%</th>

                <th>Nos</th>
                <th>%</th>

                <th>Nos</th>
                <th>%</th>

                <th>Nos</th>
                <th>%</th>

            </tr>

        </thead>

        <tbody>

            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>

                    @Html.HiddenFor(m => m[i].Id)
                    @Html.HiddenFor(m => m[i].CancerType)

                    <td class="left">
                        @Model[i].CancerType
                    </td>

                    <!-- 00-14 Male -->

                    <td>
                        @Html.TextBoxFor(m => m[i].Male_00_14,new { @class = "form-control male0014" })
                    </td>

                    <td class="center">
                        @(ViewBag.TotalMale0014 == 0? "0.0": ((Model[i].Male_00_14 * 100.0) / ViewBag.TotalMale0014).ToString("0.0"))
                    </td>

                    <!-- 00-14 Female -->

                    <td>
                        @Html.TextBoxFor(m => m[i].Female_00_14,new { @class = "form-control female0014" })
                    </td>

                    <td class="center">
                        @(ViewBag.TotalFemale0014 == 0? "0.0": ((Model[i].Female_00_14 * 100.0) / ViewBag.TotalFemale0014).ToString("0.0"))
                    </td>

                    <!-- Total 00-14 -->

                    <td>
                        @Html.TextBoxFor(m => m[i].Total_00_14,
 new
 {
     @class = "form-control total0014",
     @readonly = "readonly"
 })
                    </td>

                    <td class="center">
                        @(ViewBag.Total0014 == 0
? "0.0"
: ((Model[i].Total_00_14 * 100.0) / ViewBag.Total0014).ToString("0.0"))
                    </td>

                    <!-- 15-19 Male -->

                    <td>
                        @Html.TextBoxFor(m => m[i].Male_15_19,
 new { @class = "form-control male1519" })
                    </td>

                    <td class="center">
                        @(ViewBag.TotalMale1519 == 0
? "0.0"
: ((Model[i].Male_15_19 * 100.0) / ViewBag.TotalMale1519).ToString("0.0"))
                    </td>

                    <!-- 15-19 Female -->

                    <td>
                        @Html.TextBoxFor(m => m[i].Female_15_19,
 new { @class = "form-control female1519" })
                    </td>

                    <td class="center">
                        @(ViewBag.TotalFemale1519 == 0
? "0.0"
: ((Model[i].Female_15_19 * 100.0) / ViewBag.TotalFemale1519).ToString("0.0"))
                    </td>

                    <!-- Total 15-19 -->

                    <td>
                        @Html.TextBoxFor(m => m[i].Total_15_19,
 new
 {
     @class = "form-control total1519",
     @readonly = "readonly"
 })
                    </td>

                    <td class="center">
                        @(ViewBag.Total1519 == 0
? "0.0"
: ((Model[i].Total_15_19 * 100.0) / ViewBag.Total1519).ToString("0.0"))
                    </td>

                    <!-- Grand Total -->

                    <td>
                        @Html.TextBoxFor(m => m[i].GrandTotal,
 new
 {
     @class = "form-control grandTotal",
     @readonly = "readonly"
 })
                    </td>

                    <td class="center">
                        @(ViewBag.GrandTotal == 0
? "0.0"
: ((Model[i].GrandTotal * 100.0) / ViewBag.GrandTotal).ToString("0.0"))
                    </td>

                </tr>
                }

        </tbody>



        </table>

        <br />

        <input type="submit"
               value="Save"
               class="btn btn-success" />
}
</div>
