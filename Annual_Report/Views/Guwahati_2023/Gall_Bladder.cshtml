<script>
    var ChartsGbcharts = function () {
        var initChartgbSample4 = function() {
            var chart = AmCharts.makeChart("chart_gb", {
                "theme": "light",
                "type": "serial",
                "startDuration": 1.5,

                "fontFamily": 'Open Sans',

                "color":    '#000000',

                "dataProvider": @Html.Raw(Json.Encode(@ViewBag.data)),
                //"color":["#FF0F00","#FF6600","#FF9E01","#FCD202","#F8FF01","#B0DE09"],
                "valueAxes": [{
                    "position": "left",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "dataPoints": "Count",

                    "fontSize":21

                }],



                "graphs": [{
                    //"balloonColor":"#FF0F00",
                    "fillColors":"#FF6600",
                    //"bold": true,
                    "fontSize" :"23px" ,
                    "labelText":"[[Count]]",
                    "labelColorField": "#FF0F00",
                    "color": "#000000",
                    //"labelPosition":"inside",
                    "balloonText": "[[category]]: <b>[[value]]</b>",
                    "colorField": "color",
                    "fillAlphas": 0.85,
                    "lineAlpha": 0.1,
                    "type": "column",
                    "topRadius": 1,
                    "fixedColumnWidth": 90,
                    "valueField": "Count",

                }

                ],


                "depth3D": 40,
                "angle": 30,
                "chartCursor": {
                    "categoryBalloonEnabled": false,
                    "cursorAlpha": 0,
                    "zoomable": false
                },

                "categoryField": "Key",
                "categoryAxis": {
                    "gridPosition": "start",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "fontSize":19,
                    "autoWrap":true,
                },
                "exportConfig": {
                    "menuTop": "20px",
                    "menuRight": "20px",
                    "menuItems": [{
                        "icon": '/lib/3/images/export.png',
                        "format": 'png'
                    }]
                }
            }, 0);



            $('#chart_gb').closest('.portlet').find('.fullscreen').click(function() {
                chart.invalidateSize();

            });
        }


        var initChartSample7 = function() {
            var chart = AmCharts.makeChart("chart_gbp", {
                "type": "pie",
                "theme": "light",
                "radius": 140,
                "labelRadius":50,
                "fontFamily": 'Arial',
                "fontSize" :20,
                "color":    '#000000',

                "marginBottom":250,
                "dataProvider": @Html.Raw(Json.Encode(@ViewBag.objectname)),
                "valueField": "Count",
                "titleField": "Key",
                "labelText":"[[Key]]:<br>[[Count]] ([[percents]]%)",
                "percentPrecision": 1,
                "outlineAlpha": 0.4,
                "depth3D": 15,
                "balloonText": "[[title]]<br><span style='font-size:14px'><b>[[Count]]</b> </span>",
                "angle": 30,
                "labelTickAlpha":1,
                "exportConfig": {
                    menuItems: [{
                        icon: '/lib/3/images/export.png',
                        format: 'png'
                    }]
                }
            });

            jQuery('.chart_7_chart_input').off().on('input change', function() {
                var property = jQuery(this).data('property');
                var target = chart;
                var value = Number(this.value);
                chart.startDuration = 0;

                if (property == 'innerRadius') {
                    value += "%";
                }

                target[property] = value;
                chart.validateNow();
            });

            $('#chart_gbp').closest('.portlet').find('.fullscreen').click(function() {
                chart.invalidateSize();
            });
        }



        //Diease Status Pie chart
        var initChartSamplediseaseGall = function() {
            var chart = AmCharts.makeChart("chart_diseaseGall", {
                "type": "pie",
                "theme": "light",

                "innerRadius": "50%",
                "radius": "160",

                "fontFamily": "Arial",
                "fontSize": 20,
                "color": "#000000",
                "outlineAlpha": 0,
                "pullOutRadius": 0,
                "marginBottom": 270,
                "labelRadius": 30,

                "gradientRatio": [-0.4, 0.2, 0.2],

                "balloonText": "[[Key]]<br><b>[[Count]]</b>",
                "labelText": "[[Key]]\n[[Count]] ([[percents]]%)",
                "valueField": "Count",
                "titleField": "Key",
                "colorField": "Color",
                "dataProvider": @Html.Raw(Json.Encode(ViewBag.discharge)),
            });

        }





        return {


            init: function () {


                initChartgbSample4();
                initChartSample7();
                initChartSamplediseaseGall();
            }

        };
    }();





</script>
























