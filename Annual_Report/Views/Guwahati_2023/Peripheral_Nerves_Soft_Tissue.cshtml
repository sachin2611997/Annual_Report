        }


        var initChartSample7 = function() {
            var chart = AmCharts.makeChart("chart_pnstp", {
                "type": "pie",
                "theme": "light",
                "radius": 200,
                "labelRadius":45,
                "fontFamily": 'Arial',
                "fontSize" :20,
                "color":    '#000000',

                "marginBottom":0,
                "marginRight":0,
                "marginLeft":50,
