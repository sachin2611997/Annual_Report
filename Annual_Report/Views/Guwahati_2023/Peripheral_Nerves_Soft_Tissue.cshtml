                        <!--Type of Cases-->
                        <div class="col-md-6">
                            <!-- BEGIN BORDERED TABLE PORTLET-->
                            <div class="portlet light">
                                <div class="pnbt">
                                    <div>
                                        <p class="caption-subject uppercase" style="text-align:center">Type of Case</p>
                                    </div>

                                </div>

                                <div class="portlet-body" style="height:615px">
                                    <div class="table-scrollable">
                                        <table class="table" border="1" style="table-layout:fixed">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        Type of Case
                                                    </th>
                                                    <th>
                                                        New Cases
                                                    </th>
                                                    <th>
                                                        Old Cases
                                                    </th>
                                                    <th>
                                                        Total Cases
                                                    </th>

                                                </tr>
                                            </thead>
                                            <tbody>

                                                <tr>

                                                    <td>
                                                        Total
                                                    </td>
                                                    <td>
                                                        @ViewBag.newcase (@ViewBag.newcaseper%)
                                                    </td>
                                                    <td>
                                                        @ViewBag.oldcase (@ViewBag.oldcaseper%)

                                                    </td>
                                                    <td>
                                                        @(ViewBag.newcase + ViewBag.oldcase) (@(ViewBag.newcaseper + ViewBag.oldcaseper)%)
                                                    </td>

                                                </tr>
                                                <tr>

                                                    <td>
                                                        <b>    Treated</b>
                                                    </td>
                                                    <td>
                                                        <b>    @ViewBag.NewTretedTmh (@ViewBag.NewTretedTmhper%)</b>
                                                    </td>
                                                    <td>
                                                        <b>  @ViewBag.oldtreatedtmh (@ViewBag.oldtreatedtmhper%)</b>
                                                    </td>
                                                    <td>
                                                        <b>      @(ViewBag.NewTretedTmh + ViewBag.oldtreatedtmh) (@Math.Round(((double)(ViewBag.NewTretedTmh + ViewBag.oldtreatedtmh) / (ViewBag.newcase + ViewBag.oldcase)) * 100, 1)%)</b>
                                                    </td>

                                                </tr>
                                                <tr>
                                                    @if (@ViewBag.unkcase != 0)
                                                    {
                                                        <td>
                                                            Unknown Cases
                                                        </td>

                                                        <td>
                                                            @ViewBag.unkcase (@ViewBag.unkcaseper%)
                                                        </td>


                                                        <td>
                                                            @ViewBag.untreatedtmh (@ViewBag.untreatedtmhper%)
                                                        </td>

                                                    }
                                                </tr>


                                                <tr>

                                                    <td>
                                                        Treatment Advice but Not Taken
                                                    </td>
                                                    <td>
                                                        @ViewBag.advicenotakennew (@ViewBag.advicenotakennewper)
                                                    </td>
                                                    <td>
                                                        @ViewBag.advicenotakenold (@ViewBag.advicenotakenoldper)
                                                    </td>
                                                    <td>
                                                        @(ViewBag.advicenotakennew + ViewBag.advicenotakenold) (@Math.Round(((double)(ViewBag.advicenotakennew + ViewBag.advicenotakenold) / (ViewBag.newcase + ViewBag.oldcase)) * 100, 1)%)

                                                    </td>
                                                </tr>

                                                <tr>

                                                    <td>
                                                        No Treatment
                                                    </td>
                                                    <td>
                                                        @ViewBag.norxnnew (@ViewBag.norxnnewper)
                                                    </td>
                                                    <td>
