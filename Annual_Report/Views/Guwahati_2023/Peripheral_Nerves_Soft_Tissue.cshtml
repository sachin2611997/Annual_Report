                <!--Geographic Distribution-->
                <div class="col-md-6">
                    <div class="portlet light">
                        <div class="pnbt" style="height:80px">
                            <div>
                                <p class="caption-subject uppercase" style="text-align:center;"> Geographic Distribution</p>

                            </div>

                        </div>
                        <div class="portlet-body" style="height: 650px;">
                            <div class="table-scrollable ts">
                                <table class="table" border="1">
                                    <thead>
                                        <tr>
                                            <th scope="col" style="border-bottom:thin solid">

                                                @Html.DisplayNameFor(model => model.DISTRICT)
                                            </th>
                                            <th scope="col">
                                                @Html.DisplayNameFor(model => model.DISTRICTcount)
                                            </th>
                                            <th scope="col">
                                                @Html.DisplayNameFor(model => model.Percentage)
                                            </th>


                                        </tr>

                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.DISTRICT)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.DISTRICTcount)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Percentage)%
                                                </td>

                                            </tr>
                                        }
                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <td>Other DISTRICT</td>
                                            <td>@ViewBag.other</td>
                                            <td>@ViewBag.Otherper %</td>
                                        </tr>
                                        <tr>

                                            <td>
                                                <b>  Total</b>
                                            </td>
                                            <td>
                                                <b>   @ViewBag.TotalCount</b>
                                            </td>
                                            <td><b> 100 %</b></td>
                                        </tr>

                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
