
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>Metronic | Data Tables - Responsive Datatables</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta http-equiv="Content-type" content="text/html; charset=utf-8">
    <meta content="" name="description" />
    <meta content="" name="author" />
    <!-- BEGIN GLOBAL MANDATORY STYLES -->
    <link href="http://fonts.googleapis.com/css?family=Open+Sans:400,300,600,700&subset=all" rel="stylesheet" type="text/css">
    <link href="~/assets/global/plugins/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/global/plugins/simple-line-icons/simple-line-icons.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/global/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/global/plugins/uniform/css/uniform.default.css" rel="stylesheet" type="text/css">
    <link href="~/assets/global/plugins/bootstrap-switch/css/bootstrap-switch.min.css" rel="stylesheet" type="text/css" />
    <!-- END GLO~ANDATORY STYLES -->
    <!-- BEGIN T~STYLES -->
    <link href="~/assets/global/css/components-rounded.css" id="style_components" rel="stylesheet" type="text/css" />
    <link href="~/assets/global/css/plugins.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/admin/layout4/css/layout.css" rel="stylesheet" type="text/css" />
    <link id="style_color" href="~/assets/admin/layout4/css/themes/light.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/admin/layout4/css/custom.css" rel="stylesheet" type="text/css" />
    <!-- END THEME STYLES -->
    <link rel="shortcut icon" href="favicon.ico" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.2/xlsx.full.min.js"></script>
    <style>
        .table th {
            text-align: center;
        }

        .button-container {
            display: flex;
            justify-content: center; /* Horizontally centers the button */
            align-items: center; /* Vertically centers the button */
        }

        .texthead {
            font-size: x-large !important;
            color: white !important;
            font-weight: bold !important;
        }
       .portlet-title-rm {
             background-color: #26a69a !important;
        }

        @@media print {

            .button-container {
                display: none !important;
            }

            .portlet-title {
                background-color: #09499a !important;
                border: 1px solid #30d0c1 !important;
            }

            .texthead {
                font-size: x-large !important;
                color: white !important;
            }
            .portlet-title-rm{
                 background-color: #26a69a !important;
            }
        }
    </style>

</head>
<body>
    <div class="portlet box green" style="text-align: center;">
        <div class="portlet-title-rm">
            <div class="texthead">
                Table 5(a) &nbsp;    Religion and Site-wise distribution of Cancer Patients -TMC, Mumbai  &nbsp;&nbsp;&nbsp;&nbsp;     Sex: Male  &nbsp;&nbsp;&nbsp;&nbsp;  Year: @ViewBag.year
            </div>

        </div>
        <div class="portlet-body flip-scroll">
            <table class="table table-bordered table-striped table-condensed flip-content">
                <thead class="flip-content" style="text-align: center;">
                    <tr id="header-row">
                        <th width="5%" class="active">
                            ICD-10
                        </th>

                        <th width="10%" class="active">Site</th>
                        <th class="active">Hindu</th>
                        <th class="active">Muslim</th>
                        <th class="active">Christian</th>
                        <th class="active">Sikh</th>
                        <th class="active">Jain</th>
                        <th class="active">Neo-Buddhist</th>
                        <th class="active">Parsi</th>
                        <th class="active">Jew</th>
                        <th class="active">Anglo Indian</th>
                        <th class="active">Others</th>
                        <th class="active">Unknown</th>

                        <th class="active">TOTAL</th>
                        <th class="active">%</th>

                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Year5AgeCounts != null)
                    {
                        var year5AgeCounts = Json.Decode<List<Dictionary<string, object>>>(Json.Encode(ViewBag.Year5AgeCounts));

                        var totalCount = ViewBag.TotalCount;  // Get the total count from ViewBag


                        // Initialize the sums for each age group
                        var methodSums = new Dictionary<string, int>
        {
            { "Hindu", 0 },
            { "Muslim", 0 },
            { "Christian", 0 },
            { "Sikh", 0 },
            { "Jain", 0 },
            { "Neo-Buddhist", 0 },
            { "Parsi", 0 },
            { "Jew", 0 },
            { "Anglo Indian", 0 },
            { "Others", 0 },
            { "Unknown", 0 },

        };




                        foreach (var row in year5AgeCounts)
                        {
                            var methods = row["Methods"] as Dictionary<string, object>;

                            <tr>
                                <td class="active">@row["SysValue"]</td>
                                <td class="active">@row["SiteName"]</td>
                                <td>@(methods.ContainsKey("Hindu") ? methods["Hindu"] : 0)</td>
                                <td>@(methods.ContainsKey("Muslim") ? methods["Muslim"] : 0)</td>
                                <td>@(methods.ContainsKey("Christian") ? methods["Christian"] : 0)</td>
                                <td>@(methods.ContainsKey("Sikh") ? methods["Sikh"] : 0)</td>
                                <td>@(methods.ContainsKey("Jain") ? methods["Jain"] : 0)</td>
                                <td>@(methods.ContainsKey("Neo-Buddhist") ? methods["Neo-Buddhist"] : 0)</td>
                                <td>@(methods.ContainsKey("Parsi") ? methods["Parsi"] : 0)</td>
                                <td>@(methods.ContainsKey("Jew") ? methods["Jew"] : 0)</td>
                                <td>@(methods.ContainsKey("Anglo Indian") ? methods["Anglo Indian"] : 0)</td>
                                <td>@(methods.ContainsKey("Others") ? methods["Others"] : 0)</td>
                                <td>@(methods.ContainsKey("Unknown") ? methods["Unknown"] : 0)</td>

                                <td class="active">@(methods.Values.Cast<int?>().Sum(x => x ?? 0)) </td>  <!-- Sum all the values and handle nulls by using ?? 0 -->
                                <td class="active">
                                    @(totalCount > 0 ? ((double)(methods.Values.Cast<int?>().Sum(x => x ?? 0)) / totalCount * 100).ToString("F1") : "0.0")%
                                </td>
                            </tr>
                            // Update the sum for each age group
                            methodSums["Hindu"] += methods.ContainsKey("Hindu") ? (int)methods["Hindu"] : 0;
                            methodSums["Muslim"] += methods.ContainsKey("Muslim") ? (int)methods["Muslim"] : 0;
                            methodSums["Christian"] += methods.ContainsKey("Christian") ? (int)methods["Christian"] : 0;
                            methodSums["Sikh"] += methods.ContainsKey("Sikh") ? (int)methods["Sikh"] : 0;
                            methodSums["Jain"] += methods.ContainsKey("Jain") ? (int)methods["Jain"] : 0;
                            methodSums["Neo-Buddhist"] += methods.ContainsKey("Neo-Buddhist") ? (int)methods["Neo-Buddhist"] : 0;
                            methodSums["Parsi"] += methods.ContainsKey("Parsi") ? (int)methods["Parsi"] : 0;
                            methodSums["Jew"] += methods.ContainsKey("Jew") ? (int)methods["Jew"] : 0;
                            methodSums["Anglo Indian"] += methods.ContainsKey("Anglo Indian") ? (int)methods["Anglo Indian"] : 0;
                            methodSums["Others"] += methods.ContainsKey("Others") ? (int)methods["Others"] : 0;
                            methodSums["Unknown"] += methods.ContainsKey("Unknown") ? (int)methods["Unknown"] : 0;

                        }

                    <tfoot>
                        <tr class="active">
                            <td colspan="2"><strong>Total</strong></td>
                           
                            <td>@methodSums["Hindu"]</td>
                            <td>@methodSums["Muslim"]</td>
                            <td>@methodSums["Christian"]</td>
                            <td>@methodSums["Sikh"]</td>
                            <td>@methodSums["Jain"]</td>
                            <td>@methodSums["Neo-Buddhist"]</td>
                            <td>@methodSums["Parsi"]</td>
                            <td>@methodSums["Jew"]</td>
                            <td>@methodSums["Anglo Indian"]</td>
                            <td>@methodSums["Others"]</td>
                            <td>@methodSums["Unknown"]</td>

                            <!-- Total Count (Sum of all columns) -->
                            <td>@methodSums.Values.Sum()</td>
                            <!-- Total Percentage (One Decimal Place) -->
                            <td>
                                @(totalCount > 0 ? ((double)methodSums.Values.Sum() / totalCount * 100).ToString("F1") : "0.0")%
                            </td>
                        </tr>
                        <!-- Second Row for Percentages -->
                        <tr class="active">
                            <td colspan="2"><strong>%</strong></td>
                            
                            <td>@(totalCount > 0 ? ((double)methodSums["Hindu"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Muslim"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Christian"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Sikh"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Jain"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Neo-Buddhist"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Parsi"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Jew"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Anglo Indian"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Others"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>@(totalCount > 0 ? ((double)methodSums["Unknown"] / totalCount * 100).ToString("F1") : "0.0")%</td>
                            <td>100%</td>
                            <td></td>
                            <!-- Empty cell for Total count -->
                    </tfoot>
                    }
                    </tbody>



                </table>
            </div>



        </div>
        

    </body>
</html>
<script src="~/assets/global/plugins/jquery.min.js" type="text/javascript"></script>
<script src="~/assets/global/plugins/jquery-migrate.min.js" type="text/javascript"></script>
