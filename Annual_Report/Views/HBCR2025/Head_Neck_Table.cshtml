<script>
    var ChartsNHLcharts = function () {
        var initChartnhlSample4 = function() {
            var chart = AmCharts.makeChart("chart_nhl", {
                "theme": "light",
                "type": "serial",
                "startDuration": 1.5,

                "fontFamily": 'Open Sans',

                "color":    '#000000',

                "dataProvider": @Html.Raw(Json.Encode(@ViewBag.data)),
                //"color":["#FF0F00","#FF6600","#FF9E01","#FCD202","#F8FF01","#B0DE09"],
                "valueAxes": [{
                    "position": "left",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "dataPoints": "Count",

                    "fontSize":21

                }],



                "graphs": [{
                    //"balloonColor":"#FF0F00",
                    "fillColors":"#FF6600",
                    //"bold": true,
                    "fontSize" :"23px" ,
                    "labelText":"[[Count]]",
                    "labelColorField": "#FF0F00",
                    "color": "#000000",
                    //"labelPosition":"inside",
                    "balloonText": "[[category]]: <b>[[value]]</b>",
                    "colorField": "color",
                    "fillAlphas": 0.85,
                    "lineAlpha": 0.1,
                    "type": "column",
                    "topRadius": 1,
                    "fixedColumnWidth": 90,
                    "valueField": "Count",

                }

                ],


                "depth3D": 40,
                "angle": 30,
                "chartCursor": {
                    "categoryBalloonEnabled": false,
                    "cursorAlpha": 0,
                    "zoomable": false
                },

                "categoryField": "Key",
                "categoryAxis": {
                    "gridPosition": "start",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "fontSize":19,
                    "autoWrap":true,
                },
                "exportConfig": {
                    "menuTop": "20px",
                    "menuRight": "20px",
                    "menuItems": [{
                        "icon": '/lib/3/images/export.png',
                        "format": 'png'
                    }]
                }
            }, 0);



            $('#chart_nhl').closest('.portlet').find('.fullscreen').click(function() {
                chart.invalidateSize();

            });
        }


        var initChartSample7 = function() {
            var chart = AmCharts.makeChart("chart_nhlp", {
                "type": "pie",
                "theme": "light",
                "radius": 140,
                "labelRadius":70,
                "fontFamily": 'Arial',
                "fontSize" :20,
                "color":    '#000000',
                "marginTop": 100,
                "marginBottom":30,
                "dataProvider": @Html.Raw(Json.Encode(@ViewBag.objectname)),
                "valueField": "Count",
                "titleField": "Key",
                "labelText":"[[Key]]:<br>[[Count]],[[percents]]%",
                "outlineAlpha": 0.4,
                "depth3D": 15,
                "balloonText": "[[title]]<br><span style='font-size:14px'><b>[[Count]]</b> </span>",
                "angle": 30,
                "labelTickAlpha":1,
                "exportConfig": {
                    menuItems: [{
                        icon: '/lib/3/images/export.png',
                        format: 'png'
                    }]
                }
            });

            jQuery('.chart_7_chart_input').off().on('input change', function() {
                var property = jQuery(this).data('property');
                var target = chart;
                var value = Number(this.value);
                chart.startDuration = 0;

                if (property == 'innerRadius') {
                    value += "%";
                }

                target[property] = value;
                chart.validateNow();
            });

            $('#chart_nhlp').closest('.portlet').find('.fullscreen').click(function() {
                chart.invalidateSize();
            });
        }









        return {


            init: function () {


                initChartnhlSample4();
                initChartSample7();

            }

        };
    }();





</script>






























