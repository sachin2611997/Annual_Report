                            <p class="caption-subject @*uppercase*@" style="text-align:center;font-size:30px"> Distribution of Head & Neck  Cancers-  TMC, MUMBAI : Year:2025 @ViewBag.year</p>

                        </div>

                    </div>
                    <div class="portlet-body">
                        <div>
                            <table class="table" border="1">
                                <thead>
                                    <tr>
                                        <th scope="col" style="padding: 50px;border-bottom: thin solid; text-align: center;" rowspan="2">Site</th>
                                        <th style="padding: 50px;border-bottom: thin solid;text-align:center" scope="col" rowspan="2">Sub-site</th>
                                        <th style="text-align:center" scope="col" colspan="2">Male</th>
                                        <th style="text-align:center" scope="col" colspan="2">Female</th>
                                        <th style="text-align:center" scope="col" colspan="2">Total</th>
                                    </tr>
                                    <tr>
                                        <th style="text-align:center; background-color:#edacac" scope="col">Nos</th>
                                        <th style="text-align:center; background-color:#edacac" scope="col">%</th>
                                        <th style="text-align:center; background-color:#edacac" scope="col">Nos</th>
                                        <th style="text-align:center; background-color:#edacac" scope="col">%</th>
                                        <th style="text-align:center; background-color:#edacac" scope="col">Nos</th>
                                        <th style="text-align:center; background-color:#edacac" scope="col">%</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (ViewBag.system3Values != null)
                                    {
                                        string previousSystem3 = null;
                                        int system3MaleSum = 0;
                                        int system3FemaleSum = 0;
                                        int system3TotalSum = 0;

                                        foreach (var item in ViewBag.system3Values)
                                        {
                                            bool isNewSystem3 = item.System3 != previousSystem3;

                                            if (isNewSystem3 && previousSystem3 != null)
                                            {
                                                // Subtotal Row for previous System3
                                                <tr style="background-color: #f5f5f5; font-weight:bold;">
                                                    @*<td style="text-align:center" colspan="2">Subtotal for @previousSystem3</td>*@
                                                    <td colspan="2"></td>
                                                    <td style="text-align:center">@system3MaleSum</td>
                                                    <td style="text-align:center">
                                                        @(ViewBag.tMcount != 0 ? Math.Round(system3MaleSum * 100.0 / ViewBag.tMcount, 1) : 0)
                                                    </td>
                                                    <td style="text-align:center">@system3FemaleSum</td>
                                                    <td style="text-align:center">
                                                        @(ViewBag.tFcount != 0 ? Math.Round(system3FemaleSum * 100.0 / ViewBag.tFcount, 1) : 0)
                                                    </td>
                                                    <td style="text-align:center">@system3TotalSum</td>
                                                    <td style="text-align:center">
                                                        @(ViewBag.TotalGUSCount != 0 ? Math.Round(system3TotalSum * 100.0 / ViewBag.TotalGUSCount, 1) : 0)
                                                    </td>
                                                </tr>

                                                // Reset sums
                                                system3MaleSum = 0;
                                                system3FemaleSum = 0;
                                                system3TotalSum = 0;
                                            }

                                            previousSystem3 = item.System3;

                                            var malePercentage = item.MaleCount * 100.0 / (item.TotalCount != 0 ? item.TotalCount : 1);
                                            var femalePercentage = item.FemaleCount * 100.0 / (item.TotalFCount != 0 ? item.TotalFCount : 1);
                                            var totalPercentage = item.TotalNosCount * 100.0 / (ViewBag.TotalGUSCount != 0 ? ViewBag.TotalGUSCount : 1);

                                            <tr>
                                                <td>@(isNewSystem3 ? item.System3 : "")</td>
                                                <td><b>@item.System2</b></td>
                                                <td style="text-align:center">@item.MaleCount</td>
                                                <td style="text-align:center">@Math.Round(malePercentage, 1)</td>
                                                <td style="text-align:center">@item.FemaleCount</td>
                                                <td style="text-align:center">@Math.Round(femalePercentage, 1)</td>
                                                <td style="text-align:center">@item.TotalNosCount</td>
                                                <td style="text-align:center">@Math.Round(totalPercentage, 1)</td>
                                            </tr>

                                            // Accumulate subtotal sums
                                            system3MaleSum += item.MaleCount;
                                            system3FemaleSum += item.FemaleCount;
                                            system3TotalSum += item.TotalNosCount;
                                        }

                                        // Subtotal for last System3
                                        if (previousSystem3 != null)
                                        {
                                            <tr style="background-color: #f5f5f5; font-weight:bold;">
                                                <td colspan="2"></td>
                                                <td style="text-align:center">@system3MaleSum</td>
                                                <td style="text-align:center">
                                                    @(ViewBag.tMcount != 0 ? Math.Round(system3MaleSum * 100.0 / ViewBag.tMcount, 1) : 0)
                                                </td>
                                                <td style="text-align:center">@system3FemaleSum</td>
                                                <td style="text-align:center">
                                                    @(ViewBag.tFcount != 0 ? Math.Round(system3FemaleSum * 100.0 / ViewBag.tFcount, 1) : 0)
                                                </td>
                                                <td style="text-align:center">@system3TotalSum</td>
                                                <td style="text-align:center">
                                                    @(ViewBag.TotalGUSCount != 0 ? Math.Round(system3TotalSum * 100.0 / ViewBag.TotalGUSCount, 1) : 0)
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>

                                <tfoot>
                                    <tr>
                                        <td style="text-align:center" colspan="2"><b>Head & Neck Total Cancers Cases</b></td>
                                        <td style="background-color:#edacac;text-align:center"><b>@ViewBag.tMcount</b></td>
                                        <td style="background-color:#edacac;text-align:center"><b>100.0</b></td>
                                        <td style="background-color:#edacac;text-align:center"><b>@ViewBag.tFcount</b></td>
                                        <td style="background-color:#edacac;text-align:center"><b>100.0</b></td>
                                        <td style="background-color:#edacac;text-align:center"><b>@ViewBag.TotalGUSCount</b></td>
                                        <td style="background-color:#edacac;text-align:center"><b>100.0</b></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                </div>

            </div>

