                    </div>

                </div>
                <div class="portlet-body">
                    <div>
                        @{
                            var maleRows = (List<Annual_Report.Models.System3StatsViewModel>)ViewBag.MaleRows;
                            var femaleRows = (List<Annual_Report.Models.System3StatsViewModel>)ViewBag.FemaleRows;
                            var genitoRows = (List<Annual_Report.Models.System3StatsViewModel>)ViewBag.genitoRows;
                        }

                        <table class="table" border="1">
                            <thead>
                                <tr>
                                    <th rowspan="2">Site</th>
                                    <th colspan="2" style="text-align:center">Male</th>
                                    <th colspan="2" style="text-align:center">Female</th>
                                    <th colspan="2" style="text-align:center">Total</th>
                                </tr>
                                <tr>
                                    <th style="text-align:center; background-color:#edacac">Nos</th>
                                    <th style="text-align:center; background-color:#edacac">%</th>
                                    <th style="text-align:center; background-color:#edacac">Nos</th>
                                    <th style="text-align:center; background-color:#edacac">%</th>
                                    <th style="text-align:center; background-color:#edacac">Nos</th>
                                    <th style="text-align:center; background-color:#edacac">%</th>
                                </tr>
                            </thead>
                            <tbody>
                               

                                <tr class="tcolor"><td colspan="7"><strong><u>Female Gynaecological</strong></u></td></tr>
                                @foreach (var item in femaleRows)
            {
                                    <tr>
                                        <td>@item.System3</td>
                                        <td style="text-align:center">@(item.MaleCount == 0 ? "-" : item.MaleCount.ToString())</td>
                                        <td style="text-align:center">@(item.MaleCount == 0 ? "-" : Math.Round(item.MalePercentage, 1).ToString())</td>
                                        <td style="text-align:center">@item.FemaleCount</td>
                                        <td style="text-align:center">@Math.Round(item.FemalePercentage, 1)</td>
                                        <td style="text-align:center">@item.TotalNosCount</td>
                                        <td style="text-align:center">@Math.Round(item.TotalPercentage, 1)</td>
                                    </tr>
                                }
                                <tr><td colspan="7"><strong><u>Male</u></strong></td></tr>
                                @foreach (var item in maleRows)
            {
                                    <tr>
                                        <td>@item.System3</td>
                                        <td style="text-align:center">@item.MaleCount</td>
                                        <td style="text-align:center">@Math.Round(item.MalePercentage, 1)</td>
                                        <td style="text-align:center">@(item.FemaleCount == 0 ? "-" : item.FemaleCount.ToString())</td>
                                        <td style="text-align:center">@(item.FemaleCount == 0 ? "-" : Math.Round(item.FemalePercentage, 1).ToString())</td>
                                        <td style="text-align:center">@item.TotalNosCount</td>
                                        <td style="text-align:center">@Math.Round(item.TotalPercentage, 1)</td>
                                    </tr>
                                }
