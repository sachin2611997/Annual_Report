<!-- age 20-45  -->

<script>
    var ChartsAmcharts60above = function () {
        var initChartSample5 = function() {
            var chart = AmCharts.makeChart("leadmale60above", {

                "type": "serial",
                "theme": "light",
                "dataProvider":  @Html.Raw(Json.Encode(@ViewBag.Male60above)),
                "graphs": [{
                    "fillAlphas": 0.9,
                    "lineAlpha": 0.2,
                    "type": "column",
                    "valueField": "Count",     // vlaue of the bar
                    "fixedColumnWidth": 20,     // size of the bar
                    // "showAllValueLabels": true,
                    "labelText":"[[Percentage]]" , //value on top of the bar

                    "fontSize":20,                  //size of the value
                    "fillColors":"#074799",
                    "labelPosition":"right",
                    "labelOffset": 5,      // Space between the bar and the label (adjust as needed)
                    "axisX":0,
                }],
                "valueAxes": [
              {
                  "gridThickness": 0,
                  //"title": "Axis title",
                  "fontSize": 18,
                  "labelsEnabled": false,
              },],
                "categoryAxis": {
                    "gridThickness": 0,
                    // "title": "Axis title",
                    "fontSize": 20,
                    "gridAlpha": 0 ,
                    "boldLabels":false,
                },



               "categoryField": "Key",
                "rotate": true
            }, 0);

            jQuery('.leadmale60above_chart_input').off().on('input change', function() {
                var property = jQuery(this).data('property');
                var target = chart;
                var value = Number(this.value);
                chart.startDuration = 0;
                if (property == 'innerRadius') {
                    value += "%";
                }
                target[property] = value;
                chart.validateNow();
            });
            $('#leadmale60above').closest('.portlet').find('.fullscreen').click(function() {
                chart.invalidateSize();
            });


        }

        return {
            init: function () {
            initChartSample5();
            }
        };
    }();
</script>

<script>
