    <!-- Styles -->
    <style>
        /*.portlet-body {
            position: relative;
            height: 100%;
            width: 100%;
        }*/

        @@media print {
            .col-md-6 {
                width: 50% !important;
                float: left !important;
            }


            .well {
                display: none;
            }

            body {
                background-color: #e9ecf3 !important;
            }

            .portlet {
                background-color: #ffffff !important;
            }

            .caption-subject {
                font-size: 50px !important;
            }

            u {
                color: #5b9bd1 !important;
            }
        }
        /*close media_tag*/



        .caption-subject {
            padding: 25px 0 9px 0 !important;
            font-weight: bold !important;
            font-size: 30px !important;
        }
    </style>
</head>
<body>
    <!--   age group 20-45   -->

    <div class="portlet light ">
        <div class="portlet-title">
            <div class="caption caption-md">
                <i class="icon-bar-chart theme-font-color hide"></i>
                <span class="caption-subject head theme-font-color bold uppercase"><u>Fig.10 & 11 Distribution of Ten Leading Sites of Cancer (ICD-10) for the age group 20-45 Year:2024</u></span>
            </div>

        </div>

    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="portlet light">
                <div class="portlet-title">
                    <div>
                        @*<i class="icon-bar-chart font-green-haze"></i>*@
                        <p class="caption-subject  uppercase" style="text-align:center">  Male </p>
                    </div>
                </div>
                <div class="portlet body">
                    <div id="leadmale60above" class="chart" style="height:600px">
                    </div>
                    <div class="well margin-top-20">
                        <div class="row">
                            <div class="col-sm-3">
                                <label class="text-left">Depth:</label>
                                <input class="leadmale60above_chart_input" data-property="depth3D" min="1" max="120" value="10" step="1" />
                            </div>
                            <div class="col-sm-3">
                                <label class="text-left">Angle:</label>
                                <input class="leadmale60above_chart_input" data-property="angle" min="0" max="89" value="50" step="1" />
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="portlet light">
                <div class="portlet-title">
                    <div>
                        <p class="caption-subject  uppercase" style="text-align:center"> Female </p>
                    </div>
                </div>
                <div class="portlet-body">
                    <div id="leadfemale60above" class="chart" style="height:620px;">
                    </div>
                    <div class="well margin-top-20">
                        <div class="row">
                            <div class="col-sm-3">
                                <label class="text-left">Depth:</label>
                                <input class="leadfemale60above_chart_input" data-property="depth3D" min="1" max="120" value="10" step="1" />
                            </div>
                            <div class="col-sm-3">
                                <label class="text-left">Angle:</label>
                                <input class="leadfemale60above_chart_input" data-property="angle" min="0" max="89" value="50" step="1" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

   
</body>
