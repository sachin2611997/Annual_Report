
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    
    <script src="https://cdn.zingchart.com/zingchart.min.js"></script>
    <style>
        .chart--container {
            min-height: 2000px;
            width: 100%;
            /*height: 100%;*/
        }

        .zc-ref {
            display: none;
        }

        @@media print {
        .chart--container {
           
        }
         body {
                background-color: #fff !important;
            }
        }
    </style>
</head>
<body>
    <br>
   <div style="text-align: center";> <h2><b><u>State-wise Distribution of Cancer Cases in TMC Mumbai</u> </b></h2></div>
    <div id="myChart" class="chart--container">
       
    </div>
</body>
</html>
<script>
        // Parse the serialized data passed from the controller
        var mapData = @Html.Raw(Json.Encode(@ViewBag.data));

    let chartConfig = {
        shapes: [


          {
              type: 'zingchart.maps',
              options: {
                  name: 'ind',
                  panning: true, // turn of zooming. Doesn't work with bounding box
                  zooming: true,
                  scrolling: true,
                  style: {
                      tooltip: {
                          borderColor: '#000',
                          borderWidth: '2px',
                          fontSize: '18px'
                      },
                      borderColor: '#000',
                      borderWidth: '1px',
                      controls: {
                          visible: false, // turn of zooming. Doesn't work with bounding box

                      },
                      hoverState: {
                          alpha: .28
                      },
                      items:  mapData,
                      label: { // text displaying. Like valueBox
                          fontSize: '15px',
                          visible: false
                      }
                  }
              }
          }
        ]
    };

    zingchart.loadModules('maps,maps-ind,maps-world-countries');
    zingchart.render({
        id: 'myChart',
        data: chartConfig,
        height: '100%',
        width: '100%',
    });
</script>
