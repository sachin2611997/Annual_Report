<script>
    var ChartsAgeFBcharts = function () {
        var initChart = function() {
            var agechart = AmCharts.makeChart("chart_fb", {
                 "theme": "light",
                "type": "serial",
                "startDuration": 1.5,

                "fontFamily": 'Open Sans',

                "color":    '#000000',

                "dataProvider": @Html.Raw(Json.Encode(@ViewBag.agedata)),


                //"color":["#FF0F00","#FF6600","#FF9E01","#FCD202","#F8FF01","#B0DE09"],
                "valueAxes": [{
                    "position": "left",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "dataPoints": "Count",

                    "fontSize":23

                }],
                "graphs": [{

                    "fillColors":"#6A42C2",
                    "offset":0,
                    //"bold": true,
                    "fontSize" :"25px" ,
                    "labelText":"[[Count]]",
                    "labelColorField": "#FF0F00",
                    "color": "#000000",
                    //"labelPosition":"inside",
                    "balloonText": "[[category]]: <b>[[value]]</b>",
                    "colorField": "color",
                    "fillAlphas": 1,
                    "lineAlpha": 0.1,
                    "type": "column",
                    "topRadius": 1,
                    "fixedColumnWidth": 90,
                    "valueField": "Count",


                }

                ],
                "depth3D": 40,
                "angle": 20,
                "chartCursor": {
                    "categoryBalloonEnabled": false,
                    "cursorAlpha": 0,
                    "zoomable": false
                },

                "categoryField": "Key",
                "categoryAxis": {
                    "gridPosition": "start",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "fontSize":22
                },
                "exportConfig": {
                    "menuTop": "20px",
                    "menuRight": "20px",
                    "menuItems": [{
                        "icon": '/lib/3/images/export.png',
                        "format": 'png'
                    }]
                }

            }, 0);
            jQuery('.chart_age_chart_input').off().on('input change', function() {
                var property = jQuery(this).data('property');
                var target = chart;
                chart.startDuration = 0;

                if (property == 'topRadius') {
                    target = chart.graphs[0];
                }

                target[property] = this.value;
                chart.validateNow();
            });

            $('#chart_fb').closest('.portlet').find('.fullscreen').click(function() {
                agechart.invalidateSize();
            });
        }
        return {


            init: function () {


                initChart();


            }

        };
    }();
</script>

