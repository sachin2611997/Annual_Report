                <div class="portlet light " id="age">
                    <div class="pt">
                        <div>
                            @*<i class="icon-bar-chart font-green-haze"></i>*@
                            <p class="caption-subject  uppercase font-green-haze" style="text-align:center"> Age Category</p>
                            @*<span class="caption-helper">@ViewBag.System4</span>*@
                        </div>

                    </div>

                    <div class="portlet-body">
                        <div id="chart_Head_age" class="chart" style="height: 530px;width:830px">
                        </div>

                    </div>

                </div>

                <!-- demo 2nd chart-->
                <!-- End demo 2nd chart-->
                <!-- END CHART PORTLET-->
            </div>

            <!--Geographic Distribution-->
            <div class="col-md-6">
                <div class="portlet light">
                    <div class="pt" style="height:80px">
                        <div>
                            <p class="caption-subject uppercase" style="text-align:center"> Geographic Distribution</p>
                        </div>

                    </div>
                    <div class="portlet-body" style="height:530px">
                        <div>
                            <table class="table" border="1" style="text-align:center">
                                <thead class="thead">
                                    <tr>
                                        <th scope="col" style="border-bottom:thin solid">

                                            @Html.DisplayNameFor(model => model.State)
                                        </th>
                                        <th scope="col">
                                            @Html.DisplayNameFor(model => model.Statecount)
                                        </th>
                                        <th scope="col">
                                            @Html.DisplayNameFor(model => model.Percentage)
                                        </th>


                                    </tr>

                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                            {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.State)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Statecount)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Percentage)%
                                        </td>

                                    </tr>
                                            }
                                </tbody>

                                <tfoot>
                                    <tr>
                                        <td>Other States</td>
                                        <td>@ViewBag.other</td>
                                        <td>@ViewBag.Otherper %</td>
                                    </tr>
                                    <tr>

                                        <td>
                                            <b>  Total</b>
                                        </td>
                                        <td>
                                            <b>   @ViewBag.TotalCount</b>
                                        </td>
                                        <td><b> 100 %</b></td>
                                    </tr>

                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>



            </div>


        </div>
       
     </div>
       
    <!--    add new row column Risk Factor and Comorbidity-->
   
    <div class="row">

        <div class="col-md-12">

