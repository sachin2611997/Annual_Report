                    </div>

                    <div class="portlet-body" style="height:530px;">
                        <div>
                            <table class="table" border="1">
                                <thead>
                                    <tr>
                                        <th scope="col" style="padding: 50px;border-bottom: thin solid; text-align: center;" rowspan="2">Factors</th>

                                        <th scope="col" colspan="2">Male</th>
                                        <th scope="col" colspan="2">Female</th>
                                        <th scope="col" colspan="2">Total</th>
                                    </tr>
                                    <tr>
                                        <th scope="col">Nos</th>
                                        <th scope="col">%</th>
                                        <th scope="col">Nos</th>
                                        <th scope="col">%</th>
                                        <th scope="col">Nos</th>
                                        <th scope="col">%</th>
                                    </tr>
                                </thead>

                                <tbody>


                                    <tr>
                                        <td> Smoking Tobacco</td>
                                        <td>@ViewBag.RiskSmokefactorMale</td>
                                        <td>@ViewBag.RiskSmokefactorMaleper</td>
                                        <td>@ViewBag.RiskSmokefactorFemale</td>
                                        <td>@ViewBag.RiskSmokefactorFemaleper</td>
                                        <td>@ViewBag.TotalSmokeRiskfactor</td>
                                        <td>@ViewBag.TotalSmokeRiskfactorper</td>

                                    </tr>
                                    <tr>
                                        <td>Smokless Tobacco </td>
                                        <td>@ViewBag.RiskChewfactorMale</td>
                                        <td>@ViewBag.RiskChewfactorMaleper</td>
                                        <td>@ViewBag.RiskChewfactorFemale</td>
                                        <td>@ViewBag.RiskChewfactorFemaleper</td>
                                        <td>@ViewBag.TotalChewRiskfactor</td>
                                        <td>@ViewBag.TotalChewRiskfactorper</td>
                                    </tr>
                                    <tr>
                                        <td> Alcohol</td>
                                        <td>@ViewBag.RiskDrinkfactorMale</td>
                                        <td>@ViewBag.RiskDrinkfactorMaleper</td>
                                        <td>@ViewBag.RiskDrinkfactorFemale</td>
                                        <td>@ViewBag.RiskDrinkfactorFemaleper</td>
                                        <td>@ViewBag.TotalDrinkRiskfactor</td>
                                        <td>@ViewBag.TotalDrinkRiskfactorper</td>
                                    </tr>
                                    <tr>
                                        <td> Family History </td>
                                        <td>@ViewBag.RiskFamHistfactorMale</td>
                                        <td>@ViewBag.RiskFamHistfactorMaleper</td>
                                        <td>@ViewBag.RiskFamHistfactorFemale</td>
                                        <td>@ViewBag.RiskFamHistfactorFemaleper</td>
                                        <td>@ViewBag.TotalFamHistRiskfactor</td>
                                        <td>@ViewBag.TotalFamHistRiskfactorper</td>
                                    </tr>

                                </tbody>

                                @*<tfoot>
                    <tr>
