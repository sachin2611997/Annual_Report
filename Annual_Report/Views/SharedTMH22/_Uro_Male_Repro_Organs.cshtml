                <div class="row">
                    <div class="col-md-12">
                        <!--Age-->
                        <div class="col-md-6">
                            <!-- BEGIN CHART PORTLET-->
                            <div class="portlet light " id="age">
                                <div class="umt">
                                    <div>
                                        @*<i class="icon-bar-chart font-green-haze"></i>*@
                                        <p class="caption-subject  uppercase font-green-haze" style="text-align:center"> Age Category</p>
                                        @*<span class="caption-helper">@ViewBag.System4</span>*@
                                    </div>

                                </div>

                                <div class="portlet-body">
                                    <div id="chart_uromale_age" class="chart" style="height: 650px;width:830px">
                                    </div>

                                </div>

                            </div>

                            <!-- demo 2nd chart-->
                            <!-- End demo 2nd chart-->
                            <!-- END CHART PORTLET-->
                        </div>

                        <!--Geographic Distribution-->
                        <div class="col-md-6">
                            <div class="portlet light">
                                <div class="umt" style="height:80px">
                                    <div>
                                        <p class="caption-subject uppercase" style="text-align:center"> Geographic Distribution</p>
                                    </div>

                                </div>
                                <div class="portlet-body" style="height:650px">
                                    <div class="table-scrollable">
                                        <table class="table" border="1">
                                            <thead class="thead">
                                                <tr>
                                                    <th scope="col" style="border-bottom:thin solid">

                                                        @Html.DisplayNameFor(model => model.State)
                                                    </th>
                                                    <th scope="col">
                                                        @Html.DisplayNameFor(model => model.Statecount)
                                                    </th>
                                                    <th scope="col">
                                                        @Html.DisplayNameFor(model => model.Percentage)
                                                    </th>


                                                </tr>

                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                            {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.State)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Statecount)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Percentage)%
                                                </td>

                                            </tr>
                                            }
                                            </tbody>

                                            <tfoot>
                                                <tr>
                                                    <td>Other States</td>
                                                    <td>@ViewBag.other</td>
                                                    <td>@ViewBag.Otherper %</td>
                                                </tr>
                                                <tr>

                                                    <td>
                                                        <b>  Total</b>
                                                    </td>
                                                    <td>
                                                        <b>   @ViewBag.TotalCount</b>
                                                    </td>
                                                    <td><b> 100 %</b></td>
                                                </tr>

                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>



                        </div>
                    </div>
                    </div>
    <br /><br />
    <!--Risk factor and comorbidity-->
    <div class="row">
        <div class="col-md-12">
            <!--Risk Factor-->
            <div class="col-md-6">
                <!-- BEGIN CHART PORTLET-->
                <div class="portlet light " id="age">
                    <div class="umt">
                        <div>
                        
                            <p class="caption-subject  uppercase font-green-haze" style="text-align:center"> Risk Factor</p>
                           
                        </div>

                    </div>

                    <div class="portlet-body" style="height:650px;">
                        <div>
                            <table class="table" border="1">
                                <thead>
                                    <tr>
                                        <th scope="col" style="padding: 50px;border-bottom: thin solid; text-align: center;" rowspan="2">Factors</th>

                                        <th scope="col" colspan="2">Male</th>
                                        <th scope="col" colspan="2">Female</th>
                                        <th scope="col" colspan="2">Total</th>
                                    </tr>
                                    <tr>
                                        <th scope="col">Nos</th>
                                        <th scope="col">%</th>
                                        <th scope="col">Nos</th>
                                        <th scope="col">%</th>
                                        <th scope="col">Nos</th>
                                        <th scope="col">%</th>
                                    </tr>
                                </thead>

                                <tbody>


                                    <tr>
                                        <td> Smoking Tobacco</td>
                                        <td>@ViewBag.RiskSmokefactorMale</td>
                                        <td>@ViewBag.RiskSmokefactorMaleper</td>
                                        <td>@ViewBag.RiskSmokefactorFemale</td>
                                        <td>@ViewBag.RiskSmokefactorFemaleper</td>
                                        <td>@ViewBag.TotalSmokeRiskfactor</td>
                                        <td>@ViewBag.TotalSmokeRiskfactorper</td>

                                    </tr>
                                    <tr>
                                        <td>Smokless Tobacco </td>
                                        <td>@ViewBag.RiskChewfactorMale</td>
                                        <td>@ViewBag.RiskChewfactorMaleper</td>
                                        <td>@ViewBag.RiskChewfactorFemale</td>
                                        <td>@ViewBag.RiskChewfactorFemaleper</td>
                                        <td>@ViewBag.TotalChewRiskfactor</td>
                                        <td>@ViewBag.TotalChewRiskfactorper</td>
                                    </tr>
                                    <tr>
                                        <td> Alcohol</td>
                                        <td>@ViewBag.RiskDrinkfactorMale</td>
                                        <td>@ViewBag.RiskDrinkfactorMaleper</td>
                                        <td>@ViewBag.RiskDrinkfactorFemale</td>
                                        <td>@ViewBag.RiskDrinkfactorFemaleper</td>
                                        <td>@ViewBag.TotalDrinkRiskfactor</td>
                                        <td>@ViewBag.TotalDrinkRiskfactorper</td>
                                    </tr>
                                    <tr>
                                        <td> Family History </td>
                                        <td>@ViewBag.RiskFamHistfactorMale</td>
                                        <td>@ViewBag.RiskFamHistfactorMaleper</td>
                                        <td>@ViewBag.RiskFamHistfactorFemale</td>
                                        <td>@ViewBag.RiskFamHistfactorFemaleper</td>
                                        <td>@ViewBag.TotalFamHistRiskfactor</td>
                                        <td>@ViewBag.TotalFamHistRiskfactorper</td>
                                    </tr>

                                </tbody>


                            </table>
                        </div>

                    </div>

                </div>

           
            </div>

            <!--Comorbidity-->
            <div class="col-md-6">
                <div class="portlet light">
                    <div class="umt" style="height:80px">
                        <div>
                            <p class="caption-subject uppercase" style="text-align:center"> Comorbidity</p>
                        </div>

                    </div>
                    <div class="portlet-body" style="height:650px;">
                       

                        <div class="row">

                            <!-- PIE CHART -->
                            <div class="col-md-6">
                                <h4 style="text-align:center; font-weight:bold; margin-top:5px;">Presence of Comorbidity </h4>

                                <div id="chart_comabiditypieUMRO" style="height:330px; width:100%;"> </div>

                            </div>


                            <!-- BAR CHART -->
                            <div class="col-md-6">

                                <h4 style="text-align:center; font-weight:bold;margin-top:5px;"> No. of Comorbidity </h4>

                                <div id="chart_cdscoreallUMRO" style="height:430px; width:100%;"> </div>

                            </div>

                        </div>

                    </div>
                </div>



            </div>
        </div>
    </div>

    <br /><br />


                <div class="row">
                    <div class="col-md-12">
                        <!--Type of cases-->
                        <div class="col-md-6">
                            <!-- BEGIN BORDERED TABLE PORTLET-->
                            <div class="portlet light">
                                <div class="umt" style="height:80px">
                                    <div>
                                        <p class="caption-subject uppercase" style="text-align:center">Type of Case</p>
                                    </div>

                                </div>
                                <div class="portlet-body" style="height:615px">
                                    <div class="table-scrollable">
                                        <table class="table" border="1" style="table-layout:fixed">
                                            <thead>
                                                <tr>
                                                    <th>
                                                        Type of Case
                                                    </th>
                                                    <th>
                                                        New Cases
                                                    </th>
                                                    <th>
                                                        Old Cases
                                                    </th>
                                                    <th>
                                                        Total Cases
                                                    </th>

                                                </tr>
                                            </thead>
                                            <tbody>

                                                <tr>

                                                    <td>
                                                        Total
                                                    </td>
                                                    <td>
                                                        @ViewBag.newcase (@ViewBag.newcaseper%)
                                                    </td>
                                                    <td>
                                                        @ViewBag.oldcase (@ViewBag.oldcaseper%)

                                                    </td>
                                                    <td>
                                                        @(ViewBag.newcase + ViewBag.oldcase) (@(ViewBag.newcaseper + ViewBag.oldcaseper)%)
                                                    </td>

                                                </tr>
                                                <tr>

                                                    <td>
                                                        <b>    Treated</b>
                                                    </td>
                                                    <td>
                                                        <b>    @ViewBag.NewTretedTmh (@ViewBag.NewTretedTmhper%)</b>
                                                    </td>
                                                    <td>
                                                        <b>  @ViewBag.oldtreatedtmh (@ViewBag.oldtreatedtmhper%)</b>
                                                    </td>
                                                    <td>
                                                        <b>   @(ViewBag.NewTretedTmh + ViewBag.oldtreatedtmh) (@Math.Round(((double)(ViewBag.NewTretedTmh + ViewBag.oldtreatedtmh) / (ViewBag.newcase + ViewBag.oldcase)) * 100, 1)%)</b>
                                                    </td>

                                                </tr>
                                                <tr>
                                                    @if (@ViewBag.unkcase != 0)
                                                    {
                                                        <td>
                                                            Unknown Cases
                                                        </td>

                                                        <td>
                                                            @ViewBag.unkcase (@ViewBag.unkcaseper%)
                                                        </td>


                                                        <td>
                                                            @ViewBag.untreatedtmh (@ViewBag.untreatedtmhper%)
                                                        </td>

                                                    }
                                                </tr>


                                                <tr>

                                                    <td>
                                                        Treatment Advice but Not Taken
                                                    </td>
                                                    <td>
                                                        @ViewBag.advicenotakennew (@ViewBag.advicenotakennewper)
                                                    </td>
                                                    <td>
                                                        @ViewBag.advicenotakenold (@ViewBag.advicenotakenoldper)
                                                    </td>
                                                    <td>
                                                        @(ViewBag.advicenotakennew + ViewBag.advicenotakenold) (@Math.Round(((double)(ViewBag.advicenotakennew + ViewBag.advicenotakenold) / (ViewBag.newcase + ViewBag.oldcase)) * 100, 1)%)

                                                    </td>
                                                </tr>

                                                <tr>

                                                    <td>
                                                        No Treatment
                                                    </td>
                                                    <td>
                                                        @ViewBag.norxnnew (@ViewBag.norxnnewper)
                                                    </td>
                                                    <td>
                                                        @ViewBag.norxnold (@ViewBag.norxnoldper)
                                                    </td>
                                                    <td>
                                                        @(ViewBag.norxnnew + ViewBag.norxnold) (@Math.Round(((double)(ViewBag.norxnnew + ViewBag.norxnold) / (ViewBag.newcase + ViewBag.oldcase)) * 100, 1)%)
                                                    </td>
                                                </tr>

                                            </tbody>
                                            <tfoot>



                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <!-- END BORDERED TABLE PORTLET-->
                        </div>


                        <!--Clinical Extent of Disease-->
