    <!--Disease Status-->
    <div class="row">
        <div class="col-md-12">
           

           
            <div class="col-md-6">
                <!-- BEGIN CHART PORTLET-->
                <div class="portlet light">
                    <div class="umt">
                        <div>
                           
                            <p class="caption-subject  uppercase font-green-haze" style="text-align:center"> Disease Status(@ViewBag.Totalobjectname)</p>
                          
                        </div>

                    </div>
                    <div class="portlet-body" style="height:650px">
