                                        New Cases Treated in TMC-Mumbai from ACTREC registratons
                                    </td>
                                    <td>
                                        @ViewBag.newactrigs
                                    </td>
                                    <td>
                                        @ViewBag.newactrigsper
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Prior treated Cases treated in TMC-Mumbai from ACTREC registratons
                                    </td>
                                    <td>@ViewBag.prioractrigs</td>
                                    <td>@ViewBag.prioractrigsper</td>
                                </tr>
                                <tr>
                                    <td>
