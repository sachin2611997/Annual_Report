<script>
    var ChartsActrecregischarts = function () {
     
        var initChartSample3 = function () {
            var chart = AmCharts.makeChart("chart_actrecregis", {
                "type": "serial",
                "theme": "light",

                "fontFamily": 'Open Sans',
                "color":    '#000000',


                "pathToImages": "/HBCR_REPORT/assets/global/plugins/amcharts/amcharts/images/",

                "dataProvider": [ {
                    "date": "2014",
                    "duration": 441
                }, {
                    "date": "2015",
                    "duration": 588
                }, {
                    "date": "2016",
                    "duration": 868
                }, {
                    "date": "2017",
                    "duration": 997
                }, {
                    "date": "2018",
                    "duration": 1219
                }, {
                    "date": "2019",
                    "duration": 1576
                }, {
                    "date": "2020",
                    "duration": 1509
                },
                {
                    "date": "2021",
                    "duration": 2087
                },
               
                ],
                "balloon": {
                    "cornerRadius": 6,

                },


                "graphs": [{
                    "bullet": "square",
                    "labelText": "[[duration]]",

                    "bulletBorderAlpha": 1,
                    "bulletBorderThickness": 1,
                    "fillAlphas": 0,
                    "fillColorsField": "lineColor",
                    "legendValueText": "[[value]]",
                    "lineColor": "#a72d2d", // black or use a dark hex code
                    "lineColorField": "lineColor",
                    "lineThickness": 5,               // thicker/bolder line
                    "title": "duration",
                    "valueField": "duration",

                    "fontSize":19,
                    "labelRotation": 45,
                    "labelOffset": 10,  // increase this number to move the label higher
                }],
                //     "chartScrollbar": {},
                "chartCursor": {
                    "categoryBalloonDateFormat": "YYYY MMM DD",
                    "cursorAlpha": 0,
                    "zoomable": false
                },

                "categoryAxis": {

                    "gridThickness": 0,
                    "fontSize":20,
                    "labelRotation": 90,
                    "title": "YEAR",
                    "titleFontSize": 20
                },




                "valueAxes": [
                {
                    "titleFontSize": 20  ,
                    "title": "NUMBER",
                    "gridThickness": 0,
                    "fontSize":17,
                    
                },],



                
                "categoryField": "date",
                





            });



            $('#chart_actrecregis').closest('.portlet').find('.fullscreen').click(function () {
                chart.invalidateSize();
            });


        }










        return {


            init: function () {

                initChartSample3();  
              

            }

        };
    }();





</script>















