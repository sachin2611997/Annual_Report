<body>

    <div class="portlet box purple ">
        <div class="portlet-title ac">
            <div  style="text-align:center;font-size:40px">
                <b class="accolor"> ACTREC</b>
            </div>
           
        </div>
        <div class="portlet-body">
            <h4 class="acr">ACTREC Registrations</h4>
            <br />
            <!-- Button to trigger modal -->
            <p class="acp">
                Apart from TMH, ACTREC also started the case file and referral card registrations in the recent years and during 2021, the total registration figures showed a 38% increase in the case file registrations.Figures shows the registrations for last 8 years in ACTREC.
            </p>
            <!-- Modal -->
            <div class="row">
                <div class="col-md-9">
                    <!-- BEGIN CHART PORTLET-->
                    <div class="portlet">
                        <div class="portlet box blue">
                            <div class="actred" style="text-align:center;font-size:25px;padding:10px">

                                <span class="caption-subject bold uppercase accolor">ACTREC Registrations Year : 2014-2021</span>
                                <span class="caption-helper"></span>
                            </div>





                            <div class="portlet-body">
                                <div id="chart_actrecregis" class="chart" style="height: 570px;">
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- END CHART PORTLET-->
                </div>
            </div>


            <div class="portlet box blue" style="font-size:20px">
                <div class="portlet-title actred">
                    <b class="accolor"> <p class="caption-subject uppercase" style="text-align:center;font-size:25px;padding:10px"> Registrations and Cancer cases distribution - ACTREC Year: 2021</b></p>
                </div>
                
                <div class="portlet-body">
                    <div class="table-responsive">
                        
                            <table  border="1" style="table-layout:fixed;text-align:center;width:100%;">
                                <colgroup>
                                    <col style="width:60%;">
                                    <col style="width:13.33%;">
                                    <col style="width:13.33%;">
                                    <col style="width:13.33%;">
                                </colgroup>
                                <thead>
                                    <tr>

                                        <th colspan="4" style="text-align:center;padding:10px; font-size:20px; background-color:#d9edf7; color:#000; -webkit-print-color-adjust: exact; print-color-adjust: exact;">

                                            Registrations for the year 2021
                                        </th>


                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>

                                        <td colspan="2"></td>

                                        <td>
                                            <b>   NOS</b>
                                        </td>
                                        <td></td>

                                    </tr>
                                    <tr>

                                        <td>
                                            <b>    New Case File Registrations</b>
                                        </td>
                                        <td></td>
                                        <td>
                                            2087
                                        </td>
                                        <td></td>

                                    </tr>
                                    <tr>

                                        <td>
                                            <b>   Referral Cases</b>
                                        </td>
                                        <td></td>
                                        <td>
                                            2811
                                        </td>
                                        <td></td>

                                    </tr>
                                    <tr class="colur" style="background-color:#d9edf7; -webkit-print-color-adjust: exact; print-color-adjust: exact;">


                                        <td></td>
                                        <td><b>Gender</b></td>
                                        <td>
                                            <b>  NOS</b>
                                        </td>
                                        <td><b>%</b></td>

                                    </tr>
                                    <tr>

                                        <td rowspan="3" style="vertical-align:middle"><b>Cancer Cases (Case Files)</b></td>
                                        <td>Males</td>
                                        <td>
                                            @ViewBag.male
                                        </td>
                                        <td> @ViewBag.mper</td>

                                    </tr>
                                    <tr>
                                        <td>Females</td>
                                        <td>
                                            @ViewBag.female
                                        </td>
                                        <td> @ViewBag.feper</td>
                                    </tr>
                                    <tr>
                                        <td>Total </td>
                                        <td>
                                            @ViewBag.total
                                        </td>
                                        <td> 100.0</td>
                                    </tr>
                                </tbody>
                            </table>
                    </div>
                </div>
            </div>

            
            <p class="acp">
                Above table shows the number of patients registered in the hospital and diagnosed as cancer. Out of 2087 registered cases, 1779 cases are diagnsed with the cancer.
            </p>

           <br />
            <div class="row">
                <div class="col-md-6" style="margin: 0px 0px 0px 350px;">
                    <div class="portlet box blue" style="font-size:20px">
                        <div class="portlet-title actred">
                            <b class="accolor"> <p class="caption-subject uppercase" style="text-align:center;font-size:20px;padding:10px"> residence-wise distribution of cancer - actrec year :2021</b></p>
                        </div>

                    </div>

                    <div class="portlet-body">
                        <div class="table-responsive">
                            <table class="table" border="1" style="table-layout:fixed">
                                <thead class="thead" >
                                    <tr >
                                        <th scope="col" style="font-size:20px">

                                            @Html.DisplayNameFor(model => model.State)
                                        </th>
                                        <th scope="col" style="text-align:center;font-size:20px">
                                            @Html.DisplayNameFor(model => model.Statecount)
                                        </th>
                                        <th scope="col" style="text-align:center;font-size:20px">
                                            @Html.DisplayNameFor(model => model.Percentage)
                                        </th>


                                    </tr>

                                </thead>
                                <tbody style="font-size:17px">
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.State)
                                            </td>
                                            <td style="text-align:center">
                                                @Html.DisplayFor(modelItem => item.Statecount)
                                            </td>
                                            <td style="text-align:center">
                                                @Html.DisplayFor(modelItem => item.Percentage)%
                                            </td>

                                        </tr>
                                    }
                                </tbody>

                                <tfoot style="font-size:17px">
                                    <tr>
                                        <td>Other States</td>
                                        <td style="text-align:center">@ViewBag.other</td>
                                        <td style="text-align:center">@ViewBag.Otherper %</td>
                                    </tr>
                                    <tr>

                                        <td>
                                            <b>  Total</b>
                                        </td>
                                        <td style="text-align:center">
                                            <b>   @ViewBag.TotalCount</b>
                                        </td>
                                        <td style="text-align:center"><b> 100 %</b></td>
                                    </tr>

                                </tfoot>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
