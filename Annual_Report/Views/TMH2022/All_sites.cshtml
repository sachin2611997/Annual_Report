<script>
    var ChartsAmallcharts = function () {
        var initChartSample5 = function() {
            var chart = AmCharts.makeChart("chart_5", {
                "theme": "light",
                "type": "serial",
                "startDuration": 1.5,

                "fontFamily": 'Arial',


                "color":    '#000000',

                "dataProvider": @Html.Raw(Json.Encode(@ViewBag.data)),
                //"color":["#FF0F00","#FF6600","#FF9E01","#FCD202","#F8FF01","#B0DE09"],
                "valueAxes": [{
                    "position": "left",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "dataPoints": "Count",
                    "fontSize":20,

                }],



                "graphs": [{
                    //"balloonColor":"#FF0F00",
                    "fillColors":"#FF6600",

                    //"bold": true,
                    "fontSize" :"23px" ,
                    "labelText":"[[Count]]",
                    "labelColorField": "#FF0F00",
                    "color": "#000000",
                    //"labelPosition":"inside",
                    "balloonText": "[[category]]: <b>[[value]]</b>",
                    "colorField": "color",
                    "fillAlphas": 0.85,
                    "lineAlpha": 0.1,
                    "type": "column",
                    "topRadius": 1,
                    "valueField": "Count",

                }

                ],


                "depth3D": 40,
                "angle": 20,
                "chartCursor": {
                    "categoryBalloonEnabled": false,
                    "cursorAlpha": 0,
                    "zoomable": false
                },

                "categoryField": "Key",
                "categoryAxis": {
                    "gridPosition": "start",
                    "axisAlpha": 0,
                    "gridAlpha": 0,
                    "fontSize":20,
                    "labelRotation": 45,
                },
                "exportConfig": {
                    "menuTop": "20px",
                    "menuRight": "20px",
                    "menuItems": [{
                        "icon": '/lib/3/images/export.png',
                        "format": 'png'
                    }]
                }
            }, 0);

            jQuery('.chart_5_chart_input').off().on('input change', function() {
                var property = jQuery(this).data('property');
                var target = chart;
                chart.startDuration = 0;

                if (property == 'topRadius') {
                    target = chart.graphs[0];
                }

                target[property] = this.value;
                chart.validateNow();
            });

            $('#chart_5').closest('.portlet').find('.fullscreen').click(function() {
                chart.invalidateSize();
            });
        }


        var initChartSample7 = function() {
            var chart = AmCharts.makeChart("chart_7all", {
                "type": "pie",
                "theme": "light",
                "radius": 220,
                "fontFamily": 'Open Sans',
                "fontSize":22,
                "color":    '#000000',
                "labelRadius":70,
                "marginTop":20,
                "dataProvider": @Html.Raw(Json.Encode(@ViewBag.objectname)),
                "valueField": "Count",
                "titleField": "Key",
                "labelText":"[[Key]]:<br>[[Count]],[[percents]]%",

                "outlineAlpha": 0.4,
                "depth3D": 15,
                "balloonText": "[[title]]<br><span style='font-size:14px'><b>[[Count]]</b> </span>",

                "angle": 30,
                "exportConfig": {
                    menuItems: [{
                        icon: '/lib/3/images/export.png',
                        format: 'png'
                    }]
                }



            });






            jQuery('.chart_7_chart_input').off().on('input change', function() {
                var property = jQuery(this).data('property');
                var target = chart;
                var value = Number(this.value);
                chart.startDuration = 0;

                if (property == 'innerRadius') {
                    value += "%";
                }

                target[property] = value;
                chart.validateNow();
            });

            $('#chart_7all').closest('.portlet').find('.fullscreen').click(function() {
                chart.invalidateSize();
            });
        }

        var initChartSample3 = function () {
            var chart = AmCharts.makeChart("chart_3", {
                "type": "serial",
                "theme": "light",

                "fontFamily": 'Open Sans',
                "color":    '#000000',


                "pathToImages": "/HBCR_REPORT/assets/global/plugins/amcharts/amcharts/images/",

                "dataProvider": [{
                    //  "lineColor": "#b7e021",
                    "date": "1984",

                    "duration": 10619
                }, {
                    "date": "1985",
                    "duration": 11986,

                }, {
                    "date": "1986",
                    "duration": 12447
                }, {
                    "date": "1987",
                    "duration": 13346
                }, {
                    // "lineColor": "#fbd51a",
                    "date": "1988",
                    "duration": 14734
                }, {
                    "date": "1989",
                    "duration": 15173
                }, {
                    "date": "1990",
                    "duration": 15351
                }, {
                    "date": "1991",
                    "duration": 15718,
                    //"lineColor": "#2498d2"
                }, {
                    "date": "1992",
                    "duration": 15695,

