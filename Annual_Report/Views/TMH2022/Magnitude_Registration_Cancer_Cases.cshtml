    <script>
          $(function(){
              CalculateGrandTotal();
              $("#btnAddRow").click(function () {

                  var html = "";

                  html += "<tr>";

                  html += "<td><input type='text' class='form-control input-sm'></td>";
                  html += "<td><input type='text' class='form-control input-sm'></td>";
                  html += "<td><input type='text' class='form-control input-sm'></td>";
                  html += "<td><input type='text' class='form-control input-sm'></td>";
                  html += "<td><input type='text' class='form-control input-sm'></td>";
                  html += "<td><input type='text' class='form-control input-sm'></td>";
                  html += "<td><input type='text' class='form-control input-sm'></td>";
                  html += "<td><input type='text' class='form-control input-sm'></td>";

                  html += "<td class='no-print'>";
                  html += "<button class='btn btn-xs green save'><i class='fa fa-save'></i> Save</button> ";
                  html += "<button class='btn btn-xs yellow cancel'>Cancel</button>";
                  html += "</td>";

                  html += "</tr>";

                  $("#tblData tbody").append(html);
                 
              });
              $("#tblData").on("click", ".save", function () {

                  var tr = $(this).closest("tr");

                  tr.find("td").each(function (index) {

                      if (index < 8) {

                          var value = $(this).find("input").val();

                          $(this).html(value);

                      }

                  });

                  tr.find("td:last")
                    .addClass("no-print")
                    .html(

                      "<button class='btn btn-xs blue edit'><i class='fa fa-edit'></i> Edit</button> " +

                      "<button class='btn btn-xs red delete'><i class='fa fa-trash'></i> Delete</button>"

                    );
                  CalculateGrandTotal();
              });
              $("#tblData").on("click", ".edit", function () {

                  var tr = $(this).closest("tr");

                  tr.find("td").each(function (index) {

                      if (index < 8) {

                          var text = $(this).text().trim();

                          $(this).html("<input type='text' class='form-control input-sm' value='" + text + "'>");

                      }

                  });

                  tr.find("td:last")
                    .addClass("no-print")
                    .html(

                      "<button class='btn btn-xs green save'><i class='fa fa-save'></i> Save</button>"

                    );

              });
              $("#tblData").on("click", ".delete", function () {

                  if (confirm("Delete this row?")) {

                      $(this).closest("tr").remove();
                      CalculateGrandTotal();

                  }

              });
              $("#tblData").on("click", ".cancel", function () {

                  $(this).closest("tr").remove();
                  CalculateGrandTotal();
              });

              function CalculateGrandTotal() {

                  var patient = 0;
                  var cancer = 0;
                  var male = 0;
                  var female = 0;

                  $("#tblData tbody tr").each(function () {

                      patient += Number($(this).find("td:eq(1)").text().replace(/,/g, "")) || 0;

                      cancer += Number($(this).find("td:eq(2)").text().replace(/,/g, "").replace("#", "")) || 0;

                      male += Number($(this).find("td:eq(4)").text().replace(/,/g, "")) || 0;

                      female += Number($(this).find("td:eq(6)").text().replace(/,/g, "")) || 0;

                  });

                  $("#gtPatient").text(patient.toLocaleString());

                  $("#gtCancer").text(cancer.toLocaleString());

                  $("#gtMale").text(male.toLocaleString());

                  $("#gtFemale").text(female.toLocaleString());

                  // Overall Percentages


                  if (patient > 0)
                      $("#gtCancerPer").text(((cancer / patient) * 100).toFixed(2) + "%");
                  else
                      $("#gtCancerPer").text("0%");

                  if (cancer > 0)
                      $("#gtMalePer").text(((male / cancer) * 100).toFixed(2) + "%");
                  else
                      $("#gtMalePer").text("0%");

                  if (cancer > 0)
                      $("#gtFemalePer").text(((female / cancer) * 100).toFixed(2) + "%");
                  else
                      $("#gtFemalePer").text("0%");
              }
          });
    </script>

</body>
</html>